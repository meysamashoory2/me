# Example environment variables for the ERP project.
# Copy this file to ".env" in the project root and fill in your values; the app
# loads it automatically on startup. Real OS environment variables (e.g. Windows
# "set DB_PASSWORD=...") take precedence over .env. NEVER commit real secrets.

# --- Database (PostgreSQL is the primary database) ---
DB_ENGINE=postgresql
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
# Seconds to wait for the DB connection before failing with a clear error.
DB_CONNECT_TIMEOUT=5

# --- Django (optional; defaults exist in settings.py) ---
# DJANGO_SECRET_KEY=set-a-long-random-value-in-production
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=planning.poliran,localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://planning.poliran:8000,http://planning.poliran
