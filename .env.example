# Example environment variables for the ERP project.
# Copy the values you need into your real environment. NEVER commit real
# secrets. On Windows set them as user/system environment variables (or via
# your own tooling); the app reads them from the OS environment.

# --- Database (PostgreSQL is the primary database) ---
DB_ENGINE=postgresql
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Django (optional; defaults exist in settings.py) ---
# DJANGO_SECRET_KEY=set-a-long-random-value-in-production
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=planning.poliran,localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://planning.poliran:8000,http://planning.poliran
